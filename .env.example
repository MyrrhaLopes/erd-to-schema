# Copie para .env (gitignored). Em produção estas variáveis vêm do painel do Railway (§15.4).
# Para gerar segredos: openssl rand -base64 32

NODE_ENV=development
PORT=8080
# URL pública (a do web). Em dev é o Vite, que faz proxy de /api e /collab para o servidor
APP_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
# Postgres do docker-compose (pnpm infra:up)
DATABASE_URL=postgres://erd:erd@localhost:5432/erd
BETTER_AUTH_SECRET=dev-secret-dev-secret-dev-secret-dev-secret
COLLAB_JWT_SECRET=dev-collab-dev-collab-dev-collab-dev-collab
# resend | smtp | console. Em dev: Mailpit (interface em http://localhost:8025)
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="ERD Builder <noreply@localhost>"
# RESEND_API_KEY=            # obrigatório com MAIL_DRIVER=resend
# GITHUB_CLIENT_ID=          # OAuth (opcional): callback {APP_URL}/api/auth/callback/github
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=          # OAuth (opcional): callback {APP_URL}/api/auth/callback/google
# GOOGLE_CLIENT_SECRET=
# REDIS_URL=                 # fase 7: várias réplicas do servidor
LOG_LEVEL=info
