# Copie para .env (gitignored). Em produção estas variáveis vêm do painel do Railway (§15.4).
# Para gerar segredos: openssl rand -base64 32

NODE_ENV=development
PORT=8080
# URL pública (a do web). Em dev é o Vite, que faz proxy de /api e /collab para o servidor
APP_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
# Postgres do docker-compose (pnpm infra:up)
DATABASE_URL=postgres://erd:erd@localhost:5432/erd
BETTER_AUTH_SECRET=dev-secret-dev-secret-dev-secret-dev-secret
COLLAB_JWT_SECRET=dev-collab-dev-collab-dev-collab-dev-collab
# resend | smtp | console. Em dev: Mailpit (interface em http://localhost:8025)
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="EasiER <noreply@localhost>"
# RESEND_API_KEY=            # obrigatório com MAIL_DRIVER=resend
# GITHUB_CLIENT_ID=          # OAuth (opcional): callback {APP_URL}/api/auth/callback/github
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=          # OAuth (opcional): callback {APP_URL}/api/auth/callback/google
# GOOGLE_CLIENT_SECRET=
# Documento Word no Google Drive (docs/drive-docx-plan.md). Precisa também do GOOGLE_CLIENT_ID/SECRET.
# GOOGLE_PICKER_API_KEY=     # chave de API do Picker, restrita por referrer ao APP_URL
# GOOGLE_PROJECT_NUMBER=     # número do projeto no Google Cloud (setAppId do Picker)
# DRIVE_PROVIDER=fake        # Drive em memória para dev/E2E, sem Google (recusado com APP_URL em HTTPS)
# REDIS_URL=                 # fase 7: várias réplicas do servidor (extensão Redis do Hocuspocus + líder do sync bot)
LOG_LEVEL=info

# Limites e antiabuso (padrões de produção)
# INVITES_PER_HOUR=20
# AUTH_SIGNUPS_PER_MINUTE=5
# API_RATE_PER_MINUTE=600
# MAX_PROJECTS_PER_USER=100
# MAX_CANVASES_PER_PROJECT=20
# MAX_MEMBERS_PER_PROJECT=50
# MAX_VERSIONS_PER_CANVAS=200
# METRICS_TOKEN=             # exige "Authorization: Bearer <token>" no /metrics
