{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT} {
	encode zstd gzip
	respond /healthz 200

	handle /api/* {
		reverse_proxy {$SERVER_INTERNAL_URL}
	}
	handle /collab* {
		# upgrade de WebSocket é automático
		reverse_proxy {$SERVER_INTERNAL_URL}
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		# o worker do Drizzle executa código do usuário com `new Function` → precisa de unsafe-eval só nele
		header /assets/drizzle.worker-* Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# 'wasm-unsafe-eval' é necessário para o libpg-query (WASM) no parser worker
		# apis.google.com / docs.google.com: o Google Picker, para o dono escolher a pasta do documento no Drive
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://apis.google.com https://www.gstatic.com; worker-src 'self' blob:; connect-src 'self' wss: ws: data: blob: https://www.googleapis.com; frame-src https://docs.google.com https://drive.google.com https://accounts.google.com https://content.googleapis.com; img-src 'self' data: blob: https://avatars.githubusercontent.com https://lh3.googleusercontent.com https://*.googleusercontent.com https://ssl.gstatic.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://www.gstatic.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'"
		-Server
	}
}
