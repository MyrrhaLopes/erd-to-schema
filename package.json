{
  "name": "erd-to-schema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "infra:up": "docker compose up -d postgres mailpit",
    "infra:down": "docker compose down",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "docker:build": "docker build -f apps/api/Dockerfile -t erd-server . && docker build -f apps/web/Dockerfile -t erd-web .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docker:build",
    "prod:local": "docker compose --profile prod up --build",
    "prod:scale": "REDIS_URL=redis://redis:6379 SERVER_UPSTREAMS='http://server:8080 http://server2:8080' docker compose --profile prod --profile scale up --build",
    "load": "pnpm --filter @erd/e2e load",
    "db:generate": "pnpm --filter @erd/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @erd/db migrate",
    "db:studio": "pnpm --filter @erd/db exec drizzle-kit studio",
    "env:check": "pnpm --filter @erd/api env:check"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  }
}
