{
  "name": "erd-to-schema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "infra:up": "docker compose up -d postgres mailpit",
    "infra:down": "docker compose down",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "docker:build": "docker build -f apps/web/Dockerfile -t erd-web .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prod:local": "docker compose --profile prod up --build"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  }
}
